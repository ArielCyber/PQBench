# Dockerfile (agent) - SERVER VERSION
FROM mirror.gcr.io/library/python:3.11-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

# Install Python deps
COPY requirements.txt .
RUN pip install -r requirements.txt

# Copy code
COPY agent.py /app/agent.py

# The Agent is now a server
EXPOSE 5000

# Run the gunicorn server with INCREASED TIMEOUT
# Added --timeout 300 to match the requests.post timeout
CMD ["gunicorn", "--timeout", "300", "-w", "1", "-b", "0.0.0.0:5000", "agent:app"]
