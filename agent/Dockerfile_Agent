# Dockerfile (agent)
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

# Install Python deps
COPY requirements.txt .
RUN pip install -r requirements.txt

# Copy code
# (Assuming your script is named agent.py)
COPY agent.py /app/agent.py

# Simple loop that calls the agent periodically
# INTERVAL_SEC can be overridden via env in compose
RUN printf '#!/usr/bin/env sh\nset -eu\n: ${INTERVAL_SEC:=60}\nwhile true; do\n  echo "[agent-worker] sending config...";\n  python /app/agent.py || true;\n  sleep "$INTERVAL_SEC";\ndone\n' > /app/entrypoint-worker.sh \
 && chmod +x /app/entrypoint-worker.sh

# No ports, no healthcheck in the image
CMD ["/app/entrypoint-worker.sh"]
