# Dockerfile (agent) - SERVER VERSION
FROM mirror.gcr.io/library/python:3.11-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

# Install Python deps
COPY requirements.txt .
# Make sure gunicorn is in requirements.txt (see next step)
RUN pip install -r requirements.txt

# Copy code
COPY agent.py /app/agent.py

# --- DELETED ---
# The old 'RUN printf...' and 'CMD' are gone.
# We are no longer running a loop.
# --- DELETED ---

# The Agent is now a server, so it needs to expose its port
EXPOSE 5000

# Run the gunicorn server (same as the switcher)
# This command runs the 'app' variable inside the 'agent.py' file.
CMD ["gunicorn", "-w", "1", "-b", "0.0.0.0:5000", "agent:app"]